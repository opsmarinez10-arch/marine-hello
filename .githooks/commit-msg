#!/usr/bin/env bash
# Reject commit messages that do not follow Conventional Commits.
# Enable once per clone:  git config core.hooksPath .githooks
set -euo pipefail

subject=$(head -n1 "$1")

# Let Git's own generated messages through.
if [[ "$subject" =~ ^(Merge|Revert\ \") ]]; then
  exit 0
fi

pattern='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9._-]+\))?!?: [^ ].*[^.]$'

if ! [[ "$subject" =~ $pattern ]]; then
  cat >&2 <<EOF
Commit rejected: subject does not follow Conventional Commits.

  got:      $subject
  expected: <type>(<optional scope>): <imperative summary, no trailing period>
  types:    feat fix docs style refactor perf test build ci chore revert
  example:  feat(scraper): add IMO circular news source
EOF
  exit 1
fi

if (( ${#subject} > 72 )); then
  echo "Commit rejected: subject is ${#subject} chars, keep it under 72." >&2
  exit 1
fi
